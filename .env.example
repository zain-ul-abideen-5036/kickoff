# Kickoff environment. Copy to .env.local for development. Everything is optional locally.

# Signs agency session cookies. Required in production (32+ random characters).
SESSION_SECRET=

# Required on Vercel: the code you type on /setup to create the studio owner, so nobody else can.
SETUP_CODE=

# Vercel Blob read/write token. When empty, data is stored in ./storage on disk.
BLOB_READ_WRITE_TOKEN=

# Gemini free-tier key for the summary, audience profiles and follow-up wording.
# When empty (or AI is switched off in settings), briefs are written from templates.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Resend key for optional email. When empty, email is off and share links still work.
RESEND_API_KEY=
EMAIL_FROM=Kickoff <briefs@example.com>

# Public base URL used in share links and emails.
APP_URL=http://localhost:3000
